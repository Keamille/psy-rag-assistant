# ============================================================
# 心理咨询 AI 助手 —— 环境变量模板
# 复制为 .env 后填写。禁止把真实 .env 提交进版本库。
# 完整说明见 docs/心理咨询AI助手_开发文档.md 附录 A
# ============================================================

# ========== 基础 ==========
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:5173

# ========== 鉴权 ==========
JWT_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ========== 数据库 / 中间件 ==========
# Docker 部署时由 compose 覆盖为 sqlite:////data/app.db
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
# CHROMA_HOST 留空则启用内嵌 PersistentClient 模式（需配合 CHROMA_PATH）
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=psy_knowledge_v1

# ========== 大模型 ==========
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=2

# 本地 Ollama 示例（本机已装 Ollama，切换时只改这三行）
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# ========== 检索与向量化 ==========
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.35
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
RRF_K=60
CHUNK_SIZE=420
CHUNK_OVERLAP=60
QUERY_REWRITE_ENABLED=1
# 启动时是否预加载 BGE 与重排模型。开着能让首个请求更快，
# 但两个模型各约 2.3GB 常驻，内存不足时会抛 OSError 1455「页面文件太小」。
# 开发期用 0（首次用到时再加载），生产容器内存充足时改成 1。
PRELOAD_MODELS=0

# ========== 安全 ==========
RISK_RULE_ENABLED=1
RISK_MODEL_CONFIRM=1
RISK_CONFIRM_TIMEOUT=3
HOTLINE_REGION=CN
DISCLAIMER_VERSION=v1.0

# ========== 配额与留存 ==========
MAX_UPLOAD_MB=50
DAILY_MESSAGE_QUOTA=200
MESSAGE_RATE_PER_MINUTE=20
CONVERSATION_RETENTION_DAYS=180
CRISIS_RETENTION_DAYS=365

# ========== 构建加速（国内网络建议设置） ==========
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 注意：不要设 HF_ENDPOINT=https://hf-mirror.com
# 该镜像的 resolve 端点返回"裸 302"，缺少 huggingface_hub 构造元数据所需的
# X-Repo-Commit / ETag 等响应头，会直接抛 FileMetadataError（curl 却能下）。
# 留空即走官方源。
HF_ENDPOINT=

# ========== 模型缓存（宿主机运行时用） ==========
# 相对路径按**仓库根目录**解析（不是当前工作目录），因此从 backend/ 启动也对。
# 与 compose 里的 /models/hf-cache 对应，两条路共用同一份权重。
MODEL_CACHE_DIR=models/hf-cache

